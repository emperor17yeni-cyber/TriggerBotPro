{
  "schemaVersion": 1,
  "id": "versionbridge",
  "version": "1.0.0",
  "name": "VersionBridge",
  "description": "Select target Minecraft server/protocol versions while running 1.21. Supports version listing, configuration, and graceful unsupported version handling.",
  "authors": [
    "VersionBridge Dev"
  ],
  "contact": {
    "homepage": "https://github.com/yourusername/VersionBridge",
    "sources": "https://github.com/yourusername/VersionBridge"
  },
  "license": "MIT",
  "icon": "assets/versionbridge/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.versionbridge.VersionBridgeModInitializer"
    ],
    "client": [
      "com.versionbridge.VersionBridgeClientInitializer"
    ]
  },
  "mixins": [
    "versionbridge.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "1.21",
    "java": ">=21"
  }
}
